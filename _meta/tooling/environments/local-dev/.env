SPRING_APPLICATION_NAME=registration

SERVER_SERVLET_CONTEXT_PATH=/pegasus/agency
SERVER_PORT=8080

# SECURITY
APP_SECURITY_JWT_EXPIRATION=300

# DATABASE
SPRING_DATASOURCE_URL=jdbc:h2:file:./_meta/tooling/database/registration;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# CACHE
APP_CACHE_EXPIRE_AFTER_WRITE=5
APP_CACHE_MAXIMUM_SIZE=10000

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# H2
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console

# CACHE
CACHE_TYPE=caffeine
